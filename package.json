{
  "name": "annot",
  "version": "0.19.0",
  "description": "Human-in-the-loop annotation tool for AI workflows",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-excalidraw-fonts.js",
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "demo": "tauri dev -- -- ../test-fixtures/sample.md",
    "demo:diff": "tauri dev -- -- ../test-fixtures/sample.diff",
    "demo:large": "tauri dev -- -- ../test-fixtures/large.md",
    "demo:html": "tauri dev -- -- ../test-fixtures/html/report.html",
    "demo:portals": "tauri dev -- -- ../test-fixtures/portals.md",
    "demo:mermaid": "tauri dev -- -- ../test-fixtures/mermaid-varieties.md",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "install:local": "ln -sf $PWD/src-tauri/target/release/bundle/macos/annot.app/Contents/MacOS/annot ~/.local/bin/annot && echo 'Installed annot to ~/.local/bin/annot'"
  },
  "license": "AGPL-3.0",
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "^2.3.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-bold": "^3.32.0",
    "@tiptap/extension-code": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-italic": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-strike": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "fuse.js": "^7.5.0",
    "mermaid": "^12.2.0",
    "paneforge": "^1.0.2",
    "panzoom": "^9.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte-tiptap": "^3.0.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.4"
}
